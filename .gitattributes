# 统一换行符，避免 Windows 上反复出现整文件 diff
* text=auto

*.py      text eol=lf
*.md      text eol=lf
*.html    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.txt     text eol=lf
*.json    text eol=lf
*.jsonl   text eol=lf
*.spec    text eol=lf

# Windows 批处理必须 CRLF
*.bat text eol=crlf

# 二进制资源
*.ico   binary
*.png   binary
*.zip   binary
*.wav   binary
*.mp3   binary
*.m4a   binary
*.exe   binary
*.dll   binary
*.sys   binary
*.cat   binary
*.inf   binary
